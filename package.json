    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "ts-unused-exports": "^11.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "bun@1.2.0"
