{
  "name": "ssi-client-native",
  "main": "expo-router/entry",
  "version": "1.0.0-alpha.1",
  "description": "The native client of the Service Status Indicator monitoring system",
  "author": "Remi Zlatinis",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
